{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "deepwiki": {
      "type": "remote",
      "url": "https://mcp.deepwiki.com/mcp",
      "enabled": true
    },
    "graphify": {
      "type": "local",
      "command": ["graphify-mcp"],
      "enabled": true
    },
    "notion": {
      "type": "local",
      "command": ["npx", "-y", "@notionhq/notion-mcp-server"],
      "enabled": true,
      "env": {
        "NOTION_TOKEN": "{env:NOTION_TOKEN}"
      }
    }
  }
}